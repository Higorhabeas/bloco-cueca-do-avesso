# Copie para .env.local e preencha. No deploy, cadastre os mesmos valores na Vercel.

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=

# Chave usada para assinar os cookies do painel.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAINEL_SEGREDO=

# Lista de emergência, separada por vírgula.
# A lista normal de quem entra no painel fica no Studio, em Configurações Gerais.
# Estes e-mails valem SEMPRE, mesmo que a lista do Studio esteja vazia ou fora do ar,
# para ninguém ficar trancado do lado de fora.
PAINEL_EMAILS_PERMITIDOS=

# Conta que envia os e-mails com o código de acesso.
# OPCIONAL: o lugar normal de cadastrar isso é no Studio, em Configurações Gerais.
# Estas variáveis existem só como reserva, para desenvolvimento ou para destravar
# o acesso caso o documento de configuração fique inconsistente.
GMAIL_USUARIO=
GMAIL_SENHA_APP=
