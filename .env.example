# Copie para .env.local e preencha. No deploy, cadastre os mesmos valores na Vercel.

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=

# Chave usada para assinar os cookies do painel.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAINEL_SEGREDO=

# Quem pode entrar no painel, separado por vírgula.
# Esta é a lista de acesso: só estes e-mails recebem código de login.
PAINEL_EMAILS_PERMITIDOS=

# Conta que envia os e-mails com o código de acesso.
# A senha de app é criada em: Conta Google > Segurança > Verificação em duas etapas > Senhas de app
GMAIL_USUARIO=
GMAIL_SENHA_APP=
